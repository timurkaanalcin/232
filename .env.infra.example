# Infrastructure automation — copy to .env.infra (git-ignored).
# Used by: npm run infra:bootstrap

# --- Cloudflare (required for provision + deploy) ---
# Create token: Cloudflare Dashboard → My Profile → API Tokens
# Permissions: Workers Scripts Edit, D1 Edit, Workers Durable Objects Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- App secrets (synced to Cloudflare Worker on bootstrap / CI deploy) ---
AUTH_SECRET=
AUTH_URL=https://control.org.tr

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=LiveTrack <noreply@control.org.tr>
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Optional: create super admin on remote DB during bootstrap ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- GitHub push (tarayıcı açılmıyorsa BUNU kullanın) ---
# https://github.com/settings/tokens/new → scope: repo
GITHUB_TOKEN=
