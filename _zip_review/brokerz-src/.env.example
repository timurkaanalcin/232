## Data backend
# local  = browser localStorage CRM (default, no cloud required)
# supabase = use hosted Supabase (set URL + anon key below)
VITE_DATA_MODE=local

# Optional — only needed when VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
