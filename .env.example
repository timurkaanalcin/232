# Environment variables for `next dev` (Node.js dev server).
# Copy to `.env.local` (git-ignored) and fill in real values.
# For `wrangler dev` and production, use `.dev.vars` / `wrangler secret put` instead.

# Required - generate with: openssl rand -base64 32
AUTH_SECRET=

# The canonical URL of the app
AUTH_URL=http://localhost:3000

# Google OAuth (optional - email/password login works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email for password resets (optional - https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="LiveTrack <noreply@yourdomain.com>"
